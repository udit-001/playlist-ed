---
import { META_PLACEHOLDERS, META_DEFAULTS } from '../lib/meta.js';

const { metaPlaceholder } = Astro.props;

const pageTitle = metaPlaceholder ? META_PLACEHOLDERS.title : META_DEFAULTS.pageTitle;
const metaTitle = metaPlaceholder ? META_PLACEHOLDERS.title : META_DEFAULTS.title;
const metaDescription = metaPlaceholder ? META_PLACEHOLDERS.description : META_DEFAULTS.description;
const metaImage = metaPlaceholder ? META_PLACEHOLDERS.image : META_DEFAULTS.image;
---

<title>{pageTitle}</title>
<meta name="title" content={metaTitle} />
<meta name="description" content={metaDescription} />


<meta property="og:type" content="website" />
<meta property="og:url" content="https://playlist-ed.aurax.workers.dev" />
<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={metaDescription} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://playlist-ed.aurax.workers.dev" />
<meta property="twitter:title" content={metaTitle} />
<meta property="twitter:description" content={metaDescription} />
<meta property="twitter:image" content={metaImage} />
