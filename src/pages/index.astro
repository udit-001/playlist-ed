---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.svelte';
import LinkInput from '../components/LinkInput.svelte';
import Playlists from '../components/Playlists.svelte';
import Toast from '../components/Toast.svelte';
---

<BaseLayout>
    <Header client:load logo={true}/>
    <div class="container-fluid">
        <div class="text-center m-3 mt-5 fs-5">
            <p>Paste a playlist URL and watch it in a bare player: no recommendations, no autoplay into something else.</p>
            <p>Mark videos done as you go, so a long lecture series picks up where you left off. No signup, and your progress stays in your browser.</p>
          </div>
        
          <div class="">
            <LinkInput client:load/>
          </div>
          <Playlists client:load/>
    </div>
    <Toast client:load/>
</BaseLayout>

<style scoped>
    :root{
        --bs-sidebar-width: 0px;
    }
</style>
