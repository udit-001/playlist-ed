---
import { ViewTransitions } from 'astro:transitions';
import MetaTags from '../components/MetaTags.astro';
const { metaPlaceholder } = Astro.props;
---
<!DOCTYPE html>
<html lang="en" data-bs-core="modern" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="/images/logo.svg">
    <MetaTags {metaPlaceholder}/>

    <ViewTransitions />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/halfmoon@2.0.1/css/halfmoon.min.css" rel="stylesheet" integrity="sha256-SsJizWSIG9JT9Qxbiy8xnYJfjCAkhEQ0hihxRn7jt2M=" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/halfmoon@2.0.1/css/cores/halfmoon.cores.css" rel="stylesheet" integrity="sha256-MAzAVJMU/ze52ZHcA8CeqRrCOVndMZlHwNeS2c73vP4=" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>
        // Sentry reports only from the deployed site. `import.meta.env.PROD` is
        // false under `astro dev`; the hostname check also covers serving a
        // production build locally, where PROD is true because it was built.
        const isLocalHost = ['localhost', '127.0.0.1', '0.0.0.0', '[::1]']
            .includes(window.location.hostname);

        if (import.meta.env.PROD && !isLocalHost) {
            // Imported on demand so local development never pulls the SDK.
            import('@sentry/browser').then((Sentry) => {
                Sentry.init({
                    dsn: 'https://b34bb0e9f941c821a0c9b98636517040@o444924.ingest.sentry.io/4506640318857216',
                    tracesSampleRate: 1.0,
                    replaysSessionSampleRate: 0.1,
                    replaysOnErrorSampleRate: 1.0,
                    integrations: [new Sentry.BrowserTracing(), new Sentry.Replay()],
                });
            });
        }
    </script>
</head>
<body class="ps-md-sbwidth">
    <slot />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "8e20fbf37f3d47e3b40656eaea4aaad9"}'></script>
</body>
</html>

<style is:global>
    /* A YouTube title or channel handle can contain one unbreakable token - a
       URL, or a long channel name with no spaces. A flex item floors at its
       min-content size, so without this the row overflows its container and
       pushes the row's own controls outside it. `anywhere` rather than
       `break-word`, because only `anywhere` also shrinks the intrinsic
       min-content size, which is what lets the flex item shrink at all. */
    .list-group-item > div,
    .sidebar-nav .nav-link {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    /* Rows and page transitions animate. Collapse them for anyone who asks
       for less motion. */
    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>
